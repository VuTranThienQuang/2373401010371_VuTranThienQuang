              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"Status code is 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"User ID is correct\", function () {\r\n    const user = pm.response.json();\r\n    pm.expect(user.id).to.eql(8684137);\r\n});\r\n\r\npm.test(\"User information is correct\", function () {\r\n    const user = pm.response.json();\r\n\r\n    pm.expect(user.name).to.eql(\"Nguyen Van A\");\r\n    pm.expect(user.gender).to.eql(\"male\");\r\n    pm.expect(user.status).to.eql(\"active\");\r\n});\r\n"
