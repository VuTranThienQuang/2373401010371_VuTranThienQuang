      "name": "Positive_Cases",
      "item": [
        {
          "name": "Tạo người dùng",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"User 1 created successfully\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nif (pm.response.code === 201) {\r\n    const token = pm.environment.get(\"token\");\r\n    const runId = pm.variables.get(\"runId\");\r\n\r\n    const users = [\r\n        {\r\n            name: \"Tran Thi B\",\r\n            gender: \"female\",\r\n            email: `tranthib${runId}@example.com`,\r\n            status: \"active\"\r\n        },\r\n        {\r\n            name: \"Le Van C\",\r\n            gender: \"male\",\r\n            email: `levanc${runId}@example.com`,\r\n            status: \"inactive\"\r\n        }\r\n    ];\r\n\r\n    function createNext(index) {\r\n        if (index >= users.length) {\r\n            console.log(\"Hoan tat tao 3 users.\");\r\n            return;\r\n        }\r\n\r\n        pm.sendRequest({\r\n            url: \"https://gorest.co.in/public/v2/users\",\r\n            method: \"POST\",\r\n            header: {\r\n                \"Content-Type\": \"application/json\",\r\n                \"Authorization\": \"Bearer \" + token\r\n            },\r\n            body: {\r\n                mode: \"raw\",\r\n                raw: JSON.stringify(users[index])\r\n            }\r\n        }, function (err, res) {\r\n            if (err) {\r\n                console.error(\"Loi tao user:\", err);\r\n                return;\r\n            }\r\n\r\n            console.log(\r\n                \"User \" + (index + 2) +\r\n                \" - HTTP \" + res.code,\r\n                res.json()\r\n            );\r\n\r\n            pm.test(\r\n                \"User \" + (index + 2) + \" returns 201\",\r\n                function () {\r\n                    pm.expect(res.code).to.eql(201);\r\n                }\r\n            );\r\n\r\n            createNext(index + 1);\r\n        });\r\n    }\r\n\r\n    if (token) {\r\n        createNext(0);\r\n    } else {\r\n        console.error(\"Khong tim thay environment variable token.\");\r\n    }\r\n}\r\n\r\n"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\nconst runId = Date.now();\r\n\r\npm.variables.set(\"runId\", runId);\r\npm.variables.set(\"email1\", `nguyenvana${runId}@example.com`);\r\npm.variables.set(\"email2\", `tranthib${runId}@example.com`);\r\npm.variables.set(\"email3\", `levanc${runId}@example.com`);\r\n\r\n\r\n"
                ]
              }
            }
